# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Your site's address, e.g. https://giftpicker.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Who can open /admin (your email), comma separated
ADMIN_EMAILS=

# "sample" uses the built-in product list instead of the products table
CATALOG=

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Stripe (dashboard > Developers)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "on" once Stripe Tax is set up for the states you sell in
STRIPE_TAX=off

# Your markup on the source price. Shoppers see one price, with no fees.
MARKUP_PERCENT=10
# Family perk: someone who got a business's gift, made an account and saved
# PERK_PEOPLE people gets PERK_PERCENT off their next gift.
PERK_PEOPLE=3
PERK_PERCENT=10

# How many days a gift link stays open
CLAIM_DAYS=60

# Email (resend.com) and the secret Vercel Cron sends
RESEND_API_KEY=
REMINDER_FROM=Gift Picker <gifts@yourdomain.com>
CRON_SECRET=

# Amazon Associates tracking ID (like yourname-20). Every Amazon link carries it.
AMAZON_TAG=
# Shown on /privacy for account deletion requests (optional).
NEXT_PUBLIC_CONTACT_EMAIL=

# CJdropshipping: API key from CJ's API page (Authorization > API).
CJ_API_KEY=
# 1 = pay each CJ order from your CJ balance as it's placed; blank = you pay in CJ.
CJ_AUTO_PAY=
# 1 = send test orders CJ won't ship or charge.
CJ_SANDBOX=
# Country CJ ships from (default US warehouse).
CJ_FROM_COUNTRY=US
